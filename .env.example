BOUNTYOS_EXECUTION_MODE=passive
BOUNTYOS_MAIN_PROVIDER=gemini
BOUNTYOS_MAIN_MODEL=gemini-2.5-flash
BOUNTYOS_FAST_MODEL=gemini-2.5-flash
BOUNTYOS_REASONING_MODEL=gemini-2.5-pro
BOUNTYOS_REPORT_MODEL=gemini-2.5-pro
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Local dev
DATABASE_URL=sqlite:///./bountyos.db
# Cloud SQL Postgres via Unix socket example:
# DATABASE_URL=postgresql+psycopg://bountyos_user:CHANGE_ME@/bountyos?host=/cloudsql/PROJECT_ID:asia-south1:bountyos-db
# Cloud SQL Postgres via private/public IP example:
# DATABASE_URL=postgresql+psycopg://bountyos_user:CHANGE_ME@127.0.0.1:5432/bountyos
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
BOUNTYOS_DEBATE_ENABLED=false
BOUNTYOS_TAKEOVER_ENABLED=false
BOUNTYOS_BROWSER_AGENT_ENABLED=false
BOUNTYOS_VERIFY_TLS=true
BOUNTYOS_TAKEOVER_CONCURRENCY=20
BOUNTYOS_TAKEOVER_INTERVAL_SECONDS=86400
